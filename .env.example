# Distributed DSH plugin: keep writable state outside the npm package.
# Set DAFEIYU_HOME in the DSH process environment (or plugin homeDir).
# Do not rely on HOME settings inside a .env file to locate that .env itself.
# DAFEIYU_HOME=E:/DafeiyuCompanion
# See docs/DSH_RELEASE.md; .env belongs in the selected home.

# Optional: backend provider config. Keep actual values in ignored .env or app settings.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=
# See speech/README.md for supported speech environment variables.
# Validated stable configuration on this Core Ultra 5 225H:
# DAFEIYU_ASR_DEVICE=CPU
# Optional local preview capability; the application's early-interruption switch stays off by default.
# DAFEIYU_STREAM_ASR=1
# Optional alternative CPU TTS. Prepare its fixed model before selecting it.
# DAFEIYU_TTS_BACKEND=kokoro
# ZipVoice additionally requires an authorized local reference WAV and its exact text.
# DAFEIYU_ZIPVOICE_REFERENCE=D:/path/to/reference.wav
# DAFEIYU_ZIPVOICE_REFERENCE_TEXT=参考录音中实际说出的文字
# DAFEIYU_LLM_DEVICE=CPU
# To retry NPU after a model/driver update: DAFEIYU_ASR_DEVICE=NPU
# DAFEIYU_ASR_RETRY=1

# Explicit saved tts_mode wins over launch defaults. auto selects IndexTTS / MOSS only.
# DAFEIYU_VOICE_MODE=api
# Models/runtimes use the selected HOME; overrides below are examples only.
# DAFEIYU_INDEX_PYTHON=E:/DafeiyuCompanion/runtimes/index-tts-py311/Scripts/python.exe
# DAFEIYU_INDEX_SOURCE=E:/DafeiyuCompanion/source/index-tts-2.5
# DAFEIYU_INDEX_MODEL=E:/DafeiyuCompanion/models/index-tts-2.5
# Configure an authorized reference WAV; it is never inferred from a model name.
# DAFEIYU_INDEX_PROMPT_WAV=E:/DafeiyuCompanion/voices/reference.wav
# Choose GPU model in settings: gpu_tts_model=index_tts|gpt_sovits.
# Both GPU models use the same managed loopback:8770 endpoint; only one runs.
# GPT-SoVITS v5 turbo preparation: python scripts/prepare_gpt_sovits.py
# DAFEIYU_GSV_PYTHON=E:/DafeiyuCompanion/runtimes/gpt-sovits-py311/Scripts/python.exe
# DAFEIYU_GSV_SOURCE=E:/DafeiyuCompanion/source/gpt-sovits-v5
# DAFEIYU_GSV_MODEL=E:/DafeiyuCompanion/models/gpt-sovits-v5
# DAFEIYU_GSV_PROMPT_WAV=E:/DafeiyuCompanion/voices/reference.wav
# DAFEIYU_GSV_PROMPT_TEXT=Exact transcript of the authorized 3-10 second recording.
# Idle timeout only applies to lazy/auto mode; explicit GPU stays resident.
# DAFEIYU_GSV_IDLE_SECONDS=900
# DAFEIYU_MOSS_PYTHON=E:/DafeiyuCompanion/runtimes/moss-tts/Scripts/python.exe
# DAFEIYU_MOSS_SOURCE=E:/DafeiyuCompanion/source/moss-tts-nano
# DAFEIYU_MOSS_MODEL=E:/DafeiyuCompanion/models/moss-tts-nano
# DAFEIYU_MOSS_THREADS=4
# ASR remains a separate local CPU process; retired VITS is disabled by the launcher.
# All speech modes drive realtime mouth animation from playback PCM in the browser.
# No offline forced-alignment service is used or started.

# Actual cloud full-duplex speech mode (conversation_mode=moss_live in settings).
# Independent MOSS credentials; never reuse the DeepSeek / TTS API key implicitly.
# Foreground MOSS speech delegates complex tasks to the saved DeepSeek LLM.
# MOSS_API_KEY=
# The launcher releases owned local TTS services in this mode; voice bypasses local ASR.
# Key presence is configured/not_probed; health checks never create paid sessions.

# Keep runtime temporary files and language-data caches off the system drive.
# TEMP=E:/DafeiyuCompanion/cache/tmp
# TMP=E:/DafeiyuCompanion/cache/tmp
# NLTK_DATA=E:/DafeiyuCompanion/cache/nltk
# XDG_CACHE_HOME=E:/DafeiyuCompanion/cache
# Optional System One judgment layer (off until enabled in application settings).
# Ark Beijing: open doubao-seed-2-1-lite-260915 and set endpoint/key in Settings.
# Credentials are provider-specific, never copied between providers or from LLM/TTS.
ARK_API_KEY=
# Legacy TokenToSea Clef Omni; provider regional restrictions may apply.
TOKENTOSEA_API_KEY=
