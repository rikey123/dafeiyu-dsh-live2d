{
  "name": "dafeiyu-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "setup:avatar": "node download-live2d.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "build:dsh": "vite build --config vite.dsh.config.ts"
  },
  "dependencies": {
    "@pipecat-ai/client-js": "1.16.0",
    "@pipecat-ai/websocket-transport": "1.8.2",
    "@vitejs/plugin-react": "^4.7.0",
    "es-toolkit": "^1.51.0",
    "lucide-react": "^0.468.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.3.5",
    "wlipsync": "1.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "pixi-live2d-display": {
      "gh-pages": "^6.3.0"
    }
  }
